# Omniora frontend configuration. Copy to `.env.local` to override locally.
#
# Every VITE_* variable is embedded in the PUBLIC JavaScript bundle.
# Never put secrets here (model API keys, database URLs, signing keys).
# The app refuses to start if a VITE_* name looks like a secret.

# Which service adapters to use: "demo" (browser storage, the only mode implemented today)
# or "api" (HTTP backend; fails at startup until the API adapters exist).
VITE_OMNIORA_SERVICE_MODE=demo

# Required when VITE_OMNIORA_SERVICE_MODE=api. Must be https (http allowed only for localhost in dev).
# VITE_OMNIORA_API_BASE_URL=https://api.example.com

# debug | info | warn | error | silent. Defaults: debug in development, warn in production.
# VITE_OMNIORA_LOG_LEVEL=warn
