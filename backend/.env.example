# Omniora backend configuration. Copy to `backend/.env` (git-ignored) or set real environment variables.
# These values are SERVER-SIDE ONLY. Never copy them into the frontend's VITE_* variables.

# development | test | production. Production enforces secure cookies and explicit https CORS origins.
OMNIORA_ENV=development

# PostgreSQL connection (required).
OMNIORA_DATABASE_URL=postgresql://omniora:change-me@localhost:5432/omniora

# Browser origins allowed to call the API with credentials (comma-separated, no trailing slash).
# The frontend and the API must be same-site (e.g. app.example.com + api.example.com) because the
# session cookie is SameSite=Lax.
OMNIORA_CORS_ORIGINS=http://localhost:5173

# Model provider for the Project Manager agent: anthropic (default) or groq.
# Only the selected provider's key is used; a key for another provider never switches providers.
# Without the selected provider's key, starting a run returns 503 provider-not-configured
# instead of fabricating output.
OMNIORA_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GROQ_API_KEY=your-groq-key-here

# Optional planning tuning. Unset values use the selected provider's defaults:
#   anthropic: OMNIORA_PM_MODEL=claude-opus-5-5     OMNIORA_PM_EFFORT=high    OMNIORA_PM_MAX_OUTPUT_TOKENS=16000
#   groq:      OMNIORA_PM_MODEL=openai/gpt-oss-120b OMNIORA_PM_EFFORT=medium  OMNIORA_PM_MAX_OUTPUT_TOKENS=6000
# (The Groq default fits the Developer tier's 8K tokens-per-minute limit for gpt-oss-120b.)
# OMNIORA_PM_MODEL=
# OMNIORA_PM_EFFORT=
# OMNIORA_PM_MAX_OUTPUT_TOKENS=
# OMNIORA_PM_MAX_ATTEMPTS=3
# OMNIORA_MODEL_TIMEOUT_SECONDS=300
# OMNIORA_MODEL_TRANSPORT_RETRIES=2
# OMNIORA_ANTHROPIC_REFUSAL_FALLBACK=true
# OMNIORA_RUNS_PER_USER_PER_HOUR=10
# OMNIORA_WORKER_LEASE_SECONDS=60
# OMNIORA_JOB_MAX_DELIVERIES=3
# OMNIORA_LOG_LEVEL=INFO
